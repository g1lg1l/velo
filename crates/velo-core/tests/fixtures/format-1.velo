    scenes: [(
        id: "s_qaLQ",
        name: "Tunnel",
        nodes: [(
            id: "n_IZKa",
            kind: "velo.shader",
            name: "Tunnel",
            pos: (0.0, 0.0),
            code: Some("/*{\n  \"name\": \"My Shader\",\n  \"category\": \"generator\",\n  \"description\": \"A tunnel that breathes with the bass and flashes on the kick. Change anything: it runs as you type\",\n  \"params\": [\n    { \"id\": \"speed\", \"type\": \"float\", \"default\": 0.5, \"min\": 0.0, \"max\": 4.0 },\n    { \"id\": \"rings\", \"type\": \"float\", \"default\": 8.0, \"min\": 1.0, \"max\": 32.0 },\n    { \"id\": \"tint\", \"type\": \"color\", \"default\": [0.55, 0.35, 1.0, 1.0] }\n  ]\n}*/\n\n// uv runs 0..1 across the picture, px counts pixels. `g` holds time, aspect, bpm, beat_phase,\n// bar_phase and the audio, 0..1: level, bass, mid, high, kick, snare, hat. Each param above is\n// a variable by its id. For an effect, add \"inputs\": [{ \"id\": \"src\", \"type\": \"texture\" }] to\n// the header and read it with textureSample(src, smp, uv).\nfn main_image(uv: vec2f, px: vec2f) -> vec4f {\n    let p = (uv - 0.5) * vec2f(g.aspect, 1.0);\n    let depth = 0.2 / max(length(p), 0.001) + g.time * speed;\n    let bands = 0.5 + 0.5 * sin(depth * rings + atan2(p.y, p.x) * 3.0);\n    let glow = bands * (0.4 + g.bass) + 0.5 * g.kick;\n    return vec4f(tint.rgb * glow * smoothstep(0.0, 0.3, length(p)), 1.0);\n}\n"),
            file: Some("tunnel.wgsl"),
        ), (
            id: "n_e1cN",
            kind: "velo.feedback",
